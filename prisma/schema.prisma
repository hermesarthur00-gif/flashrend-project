// FlashInv : schéma de la base (Neon PostgreSQL)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentification (Better Auth)
// ---------------------------------------------------------------------------

model User {
  id               String    @id
  name             String
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  twoFactorEnabled Boolean?  @default(false)

  // FlashInv
  role          Role       @default(CLIENT)
  firstName     String?
  lastName      String?
  phone         String?
  reference     String?    @unique // référence de virement, ex. FI-48210
  cashEur       Decimal    @default(0) @db.Decimal(18, 2) // solde disponible en euros, non investi
  profile       ProfileId?
  profileSetAt  DateTime?
  kycStatus     KycStatus  @default(NONE)
  suspendedAt   DateTime?
  suspendReason String?

  sessions      Session[]
  accounts      Account[]
  twoFactors    TwoFactor[]
  kyc           KycSubmission[]
  positions     Position[]
  deposits      Deposit[]
  withdrawals   Withdrawal[]
  bankAccounts  BankAccount[]
  notifications Notification[]
  pushSubs      PushSubscription[]
  activity      Activity[]
  snapshots     PortfolioSnapshot[]
  actionCodes   ActionCode[]
  auditLogs     AuditLog[]       @relation("actor")
  kycReviews    KycSubmission[]  @relation("reviewer")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

// ---------------------------------------------------------------------------
// Métier
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  ADMIN
}

enum ProfileId {
  CAREFUL
  BALANCED
  BOLD
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum Currency {
  USD
  EUR
}

enum DepositStatus {
  ANNOUNCED // déclaré par le client, en attente de vérification
  CREDITED // reçu, solde disponible crédité
  REJECTED
}

enum DepositMethod {
  STANDARD // virement classique
  INSTANT // virement instantané
}

enum WithdrawalStatus {
  REQUESTED
  SENT
  REJECTED
}

enum ActivityType {
  DEPOSIT
  INVEST
  WITHDRAW
  REBALANCE
  PROFILE
  DIVEST
}

/// Cryptos proposées (BTC, ETH…)
model Asset {
  symbol      String   @id
  name        String
  coingeckoId String   @unique
  priceEur    Decimal  @default(0) @db.Decimal(24, 8) // cours en euros
  change24h   Decimal  @default(0) @db.Decimal(10, 4)
  priceAt     DateTime?
  active      Boolean  @default(true)

  allocations ProfileAllocation[]
  positions   Position[]
}

/// Répartition cible d'un profil
model ProfileAllocation {
  id      String    @id @default(cuid())
  profile ProfileId
  symbol  String
  asset   Asset     @relation(fields: [symbol], references: [symbol])
  percent Decimal   @db.Decimal(5, 2)

  @@unique([profile, symbol])
}

/// Quantité de chaque crypto détenue par un client
model Position {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  asset     Asset    @relation(fields: [symbol], references: [symbol])
  quantity  Decimal  @db.Decimal(30, 12)
  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
}

model KycSubmission {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthDate    String
  address      String
  postalCode   String
  city         String
  country      String
  docType      String // id | passport
  frontId      String? // identifiants Cloudinary (accès authentifié)
  backId       String?
  selfieId     String?
  status       KycStatus @default(PENDING)
  rejectReason String?
  reviewerId   String?
  reviewer     User?     @relation("reviewer", fields: [reviewerId], references: [id])
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

model BankAccount {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  holder    String
  iban      String
  bic       String?
  bankName  String?
  createdAt DateTime     @default(now())
  archivedAt DateTime? // remplacé par une version corrigée ou supprimé par le client
  withdrawals Withdrawal[]
}

model Deposit {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference      String
  currency       Currency
  method         DepositMethod @default(STANDARD)
  declaredAmount Decimal?      @db.Decimal(18, 2) // montant indiqué par le client
  proofId        String? // preuve du virement (Cloudinary privé)
  announcedAt    DateTime      @default(now())
  status         DepositStatus @default(ANNOUNCED)
  receivedAmount Decimal?      @db.Decimal(18, 2)
  fxRate         Decimal?      @db.Decimal(12, 6)
  creditedEur    Decimal?      @db.Decimal(18, 2)
  receivedAt     DateTime?
  processedById  String?
  note           String?
  createdAt      DateTime      @default(now())

  @@index([status])
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference     String           @unique
  amountEur     Decimal          @db.Decimal(18, 2)
  feeEur        Decimal          @default(0) @db.Decimal(18, 2)
  bankAccountId String
  bankAccount   BankAccount      @relation(fields: [bankAccountId], references: [id])
  status        WithdrawalStatus @default(REQUESTED)
  bankReference String?
  rejectReason  String?
  sentAt        DateTime?
  processedById String?
  createdAt     DateTime         @default(now())

  @@index([status])
}

/// Historique affiché au client
model Activity {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ActivityType
  title     String
  subtitle  String?
  amountEur Decimal?     @db.Decimal(18, 2)
  pending   Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // deposit | withdrawal | kyc | rebalance | info
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

/// Valeur quotidienne d'un portefeuille (courbe)
model PortfolioSnapshot {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  valueEur Decimal  @db.Decimal(18, 2)

  @@unique([userId, day])
}

/// Codes de confirmation (retrait, changement sensible)
model ActionCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  codeHash  String
  payload   Json?
  attempts  Int      @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, purpose])
}

/// Réglages du site, gérés dans l'admin (une seule ligne, id = "site")
model SiteSettings {
  id        String   @id @default("site")
  data      Json
  updatedAt DateTime @updatedAt
}

model Rebalance {
  id        String    @id @default(cuid())
  profile   ProfileId
  summary   String
  clients   Int
  actorId   String
  createdAt DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("actor", fields: [actorId], references: [id])
  action     String
  targetType String?
  targetId   String?
  data       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}
