# Base de données (Neon PostgreSQL, chaîne avec ?sslmode=require)
DATABASE_URL=

# Better Auth : secret aléatoire (openssl rand -base64 32) et URL publique du site
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comptes administrateurs à l'inscription (séparés par des virgules)
ADMIN_EMAILS=

# Resend : e-mails de contact et transactionnels (sans clé, les e-mails s'affichent dans la console)
RESEND_API_KEY=
EMAIL_FROM="FlashInv <no-reply@flashinv.com>"
CONTACT_TO_EMAIL=contact@flashinv.com

# Cloudinary : pièces d'identité (accès authentifié)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Web Push (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@flashinv.com

# Tâche planifiée Vercel (cours et valeur quotidienne des portefeuilles)
CRON_SECRET=

# Facultatif : clé CoinGecko (offre Demo) pour des limites d'appel plus larges
COINGECKO_API_KEY=
